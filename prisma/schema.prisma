model RatingSummary {
  id                   String             @id @default(uuid()) @db.Uuid
  appraisalId          String             @unique @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  averageRating        Float
  competencyCategoryId String             @db.Uuid
  appraisal            Appraisal          @relation(fields: [appraisalId], references: [id])
  competencyCategory   CompetencyCategory @relation(fields: [competencyCategoryId], references: [id])
}

/// ///////////////////////////////////////  PIP ///////////////////////////////////////////
model Pip {
  id           String          @id @default(uuid()) @db.Uuid
  title        String
  platform     String
  url          String
  startDate    DateTime
  endDate      DateTime
  duration     String
  cost         Float
  reason       String
  status       PipStatus       @default(PENDING)
  userId       String          @db.Uuid
  rejectedById String?         @db.Uuid
  rejecteAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  departmentId String?         @db.Uuid
  pId          String          @unique
  rPId         String?         @unique @db.Uuid
  claim        Claim?
  comment      Comment[]
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  rP           RecommendedPip? @relation("RecommendationToPip", fields: [rPId], references: [id])
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploads      Upload[]
}

model RecommendedPip {
  id               String    @id @default(uuid()) @db.Uuid
  rPipId           String    @unique
  aoi              String
  recommendedById  String    @db.Uuid
  recommendedForId String    @db.Uuid
  reason           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  comment          Comment[]
  pip              Pip?      @relation("RecommendationToPip")
  recommendedBy    User      @relation("PipRecommendedBy", fields: [recommendedById], references: [id])
  recommendedFor   User      @relation("PipRecommendedFor", fields: [recommendedForId], references: [id])
  uploads          Upload[]
}

model HrDepartmentApproval {
  id           String     @id @default(uuid()) @db.Uuid
  departmentId String     @db.Uuid
  approvedById String     @db.Uuid
  totalCost    Float
  status       PipStatus
  createdAt    DateTime   @default(now())
  reason       Comment[]
  approvedBy   User       @relation(fields: [approvedById], references: [id])
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

