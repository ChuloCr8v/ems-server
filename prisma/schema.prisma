model TaskIssues {
  id    String @id @default(uuid()) @db.Uuid
  issue String

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String? @db.Uuid

  reportedBy User?   @relation(fields: [userId], references: [id])
  userId     String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExtensionRequests {
  id String @id @default(uuid()) @db.Uuid

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String? @db.Uuid

  requester   User?    @relation(fields: [requesterId], references: [id])
  requesterId String?  @db.Uuid
  dueDate     DateTime
  note        String?

  status ClaimStatus? @default(PENDING)

  isVisible Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  taskId      String?    @unique
  title       String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  category    Category[]
  priority    String?
  status      TaskStatus @default(PENDING_APPROVAL)
  hasDeadline Boolean?

  isReported Boolean @default(false)

  // Relations
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy  User?  @relation("ApprovedTasks", fields: [approvedById], references: [id], onDelete: Cascade)
  createdById String @db.Uuid

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  teamId String? @db.Uuid
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  comments Comment[]

  approvedById String? @db.Uuid

  assignees UserTask[]
  uploads   Upload[]

  hasTransfer   Boolean?       @default(false)
