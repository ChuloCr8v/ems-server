}

//////////////////////////////////////////  PIP ///////////////////////////////////////////
model Pip {
  id           String          @id @default(uuid()) @db.Uuid
  pId          String          @unique
  title        String
  platform     String
  url          String
  startDate    DateTime
  endDate      DateTime
  duration     String
  cost         Float
  reason       String
  status       PipStatus       @default(PENDING)
  comment      Comment[]
  rPId         String?         @unique @db.Uuid
  rP           RecommendedPip? @relation("RecommendationToPip", fields: [rPId], references: [id], onDelete: SetNull)
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String?         @db.Uuid
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  claim        Claim?
  uploads      Upload[]
  rejectedById String?         @db.Uuid
  rejecteAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model RecommendedPip {
  id               String    @id @default(uuid()) @db.Uuid
  rPipId           String    @unique
  aoi              String
  recommendedById  String    @db.Uuid
  recommendedBy    User      @relation("PipRecommendedBy", fields: [recommendedById], references: [id])
  recommendedForId String    @db.Uuid
  recommendedFor   User      @relation("PipRecommendedFor", fields: [recommendedForId], references: [id])
  reason           String?
  comment          Comment[]
  uploads          Upload[]
  pip              Pip?      @relation("RecommendationToPip")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model HrDepartmentApproval {
  id String @id @default(uuid()) @db.Uuid

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  approvedById String @db.Uuid
  approvedBy   User   @relation(fields: [approvedById], references: [id])

  totalCost Float
  reason    Comment[]

  status PipStatus // APPROVED | REJECTED

  createdAt DateTime @default(now())

  @@index([departmentId])
}

