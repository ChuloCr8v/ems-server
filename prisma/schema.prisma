generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id          String                  @id @default(uuid())
  recipientId String?                 @db.Uuid
  actorId     String?                 @db.Uuid
  prospectId  String?                 @db.Uuid
  type        String
  message     String
  read        Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  actionData  Json?
  actionType  NotificationActionType?
  title       String?
  actor       User?                   @relation("NotificationActor", fields: [actorId], references: [id])
  prospect    Prospect?               @relation(fields: [prospectId], references: [id])
  recipient   User?                   @relation("NotificationRecipient", fields: [recipientId], references: [id])
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  eId                   String?                @unique
  personalEmail         String?                @unique
  email                 String?                @unique
  firstName             String
  lastName              String
  phone                 String?
  workPhone             String?
  role                  String?
  gender                String
  duration              String?
  jobType               JobType?
  country               String?
  state                 String?
  address               String?
  startDate             DateTime?
  dateOfBirth           DateTime?
  status                Status                 @default(PENDING)
  userRole              Role[]
  maritalStatus         MaritalStatus?
  levelId               String?                @db.Uuid
  prospectId            String?                @unique @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  defaultId             String?                @db.Uuid
  teamId                String?                @db.Uuid
  isOffboarding         Boolean                @default(false)
  appraisals            Appraisal[]            @relation("Appraised")
  appraisers            Appraisal[]            @relation("Appraiser")
  approvals             Approval[]
  approver              Approver[]
  assignments           Assignment[]
  bank                  Bank?
  taskCategory          Category[]
  claims                Claim[]
  comment               Comment[]
  contacts              Contacts?
  departmentCreator     Department?            @relation("departmentCreator")
  extensionRequests     ExtensionRequests[]
  faultReporter         Fault[]                @relation("reportedBy")
  faultResolver         Fault[]                @relation("resolvedBy")
  hrDepartmentApprovals HrDepartmentApproval[]
  invite                Invite[]
  requestDoa            LeaveRequest[]         @relation("deedOfAssignement")
  requests              LeaveRequest[]         @relation("user")
  logActor              Logs[]                 @relation("LogActor")
  logTo                 Logs[]                 @relation("LogTo")
  notificationActor     Notification[]         @relation("NotificationActor")
  notificationRecipient Notification[]         @relation("NotificationRecipient")
  initiatedOffboarding  Offboarding[]          @relation("InitiatedBy")
  offboarding           Offboarding?           @relation("InitiatedFor")
  payroll               Payroll?
  payComponent          PayrollComponent[]
  payslip               Payslip[]
  pip                   Pip[]
  projectLabels         ProjectLabels[]
  rPipBy                RecommendedPip[]       @relation("PipRecommendedBy")
  rPipFor               RecommendedPip[]       @relation("PipRecommendedFor")
  reports               Report[]
  responses             Response[]
  approvedTasks         Task[]                 @relation("ApprovedTasks")
  createdTasks          Task[]                 @relation("CreatedTasks")
  taskFrom              TaskHandover[]         @relation("TransferredFrom")
  taskTo                TaskHandover[]         @relation("TransferredTo")
  taskIssues            TaskIssues[]
  taskTransfers         TaskTransfer[]
  teamCreator           Team[]                 @relation("teamCreator")
  userDocuments         Upload[]               @relation("UserDocuments")
  defaultDepartment     Department?            @relation("default", fields: [defaultId], references: [id])
  level                 Level?                 @relation(fields: [levelId], references: [id])
  prospect              Prospect?              @relation(fields: [prospectId], references: [id])
  team                  Team?                  @relation("team", fields: [teamId], references: [id])
  userTask              UserTask[]
  departments           Department[]           @relation("DepartmentToUser")
  emails                Email[]                @relation("EmailToUser")
  prospectDocuments     Upload[]               @relation("ProspectDocuments")

  @@index([email])
  @@index([id])
  @@index([eId])
  @@index([firstName, lastName])
  @@index([levelId])
}

model Department {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @unique
  createdById             String?                  @unique @db.Uuid
  status                  DepartmentStatus?        @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  pipStatus               PipStatus?               @default(PENDING)
  appraisals              Appraisal[]
  approver                Approver[]
  createdBy               User?                    @relation("departmentCreator", fields: [createdById], references: [id])
  entitlements            DepartmentEntitlement[]
  departmentWeeklyReports DepartmentWeeklyReport[]
  hrDepartmentApprovals   HrDepartmentApproval[]
  pip                     Pip[]
  tasks                   Task[]
  teams                   Team[]
  defaultDepartment       User[]                   @relation("default")
  taskCategories          Category[]               @relation("CategoryToDepartment")
  emails                  Email[]                  @relation("DepartmentToEmail")
  projectLabels           ProjectLabels[]          @relation("DepartmentToProjectLabels")
  prospects               Prospect[]               @relation("DepartmentToProspect")
  user                    User[]                   @relation("DepartmentToUser")
}

model Team {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @unique
  createdById  String?           @db.Uuid
  status       DepartmentStatus? @default(ACTIVE)
  departmentId String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  approver     Approver[]
  task         Task[]
  createdBy    User?             @relation("teamCreator", fields: [createdById], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members      User[]            @relation("team")
}

model Prospect {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  firstName    String         @default("")
  lastName     String         @default("")
  phone        String
  gender       String
  role         String
  duration     String?
  startDate    DateTime
  jobType      JobType
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invite       Invite[]
  notification Notification[]
  upload       Upload[]
  user         User?
  departments  Department[]   @relation("DepartmentToProspect")
}

model Invite {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  token          String    @unique
  status         Status    @default(PENDING)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  declinedAt     DateTime?
  sentById       String?   @db.Uuid
  prospectId     String?   @db.Uuid
  declineReasons String[]
  comment        Comment[]
  prospect       Prospect? @relation(fields: [prospectId], references: [id])
  sentBy         User?     @relation(fields: [sentById], references: [id])
}

model Level {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  rank         Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  entitlements LevelEntitlement[]
  users        User[]
}

model Upload {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  size                    Int
  type                    String
  bytes                   Bytes?
  key                     String?
  order                   Int?
  uri                     String?
  prospectId              String?                  @db.Uuid
  userId                  String?                  @db.Uuid
  offboardingId           String?                  @db.Uuid
  commentId               String?                  @db.Uuid
  handoverId              String?                  @db.Uuid
  paymentId               String?                  @db.Uuid
  assetId                 String?                  @db.Uuid
  requestId               String?                  @db.Uuid
  claimId                 String?
  guarantorId             String?                  @db.Uuid
  publicId                String?                  @unique
  secureUrl               String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  taskId                  String?                  @db.Uuid
  pipId                   String?                  @db.Uuid
  recomPipId              String?                  @db.Uuid
  logId                   String?                  @db.Uuid
  reportItemId            String?
  appraisalSignatures     AppraisalSignatures?
  clearanceDeptSignatures ClearanceDeptSignatures?
  asset                   Asset?                   @relation("AssetImages", fields: [assetId], references: [id])
  claim                   Claim?                   @relation(fields: [claimId], references: [id])
  comment                 Comment?                 @relation(fields: [commentId], references: [id])
  guarantor               GuarantorContact?        @relation(fields: [guarantorId], references: [id])
  handover                TaskHandover?            @relation(fields: [handoverId], references: [id])
  logs                    Logs?                    @relation(fields: [logId], references: [id], onDelete: Cascade)
  offboarding             Offboarding?             @relation(fields: [offboardingId], references: [id])
  payment                 Payment?                 @relation(fields: [paymentId], references: [id])
  pip                     Pip?                     @relation(fields: [pipId], references: [id])
  prospect                Prospect?                @relation(fields: [prospectId], references: [id])
  recomPip                RecommendedPip?          @relation(fields: [recomPipId], references: [id])
  reportItems             ReportItem?              @relation(fields: [reportItemId], references: [id], onDelete: Cascade)
  request                 LeaveRequest?            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  Task                    Task?                    @relation(fields: [taskId], references: [id])
  userDocuments           User?                    @relation("UserDocuments", fields: [userId], references: [id])
  prospectDocuments       User[]                   @relation("ProspectDocuments")
}

model Contacts {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @db.Uuid
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now()) @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergency EmergencyContact[]
  guarantor GuarantorContact[]
  nextOfKin NextOfKin[]
}

model Bank {
  id            String   @id @default(uuid()) @db.Uuid
  bankName      String
  accountName   String
  accountNumber String
  userId        String?  @unique @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id])
}

model NextOfKin {
  id        String    @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  phone     String
  address   String?
  contactId String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contacts? @relation(fields: [contactId], references: [id])
}

model EmergencyContact {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  phone        String
  relationship String?
  address      String?
  contactId    String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contacts     Contacts? @relation(fields: [contactId], references: [id])
}

model GuarantorContact {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  phone        String
  address      String?
  relationship String?
  contactId    String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contacts     Contacts? @relation(fields: [contactId], references: [id])
  document     Upload[]
}

model Comment {
  id               String                @id @default(uuid()) @db.Uuid
  comment          String
  userId           String?               @db.Uuid
  inviteId         String?               @db.Uuid
  offboardingId    String?               @db.Uuid
  paymentId        String?               @db.Uuid
  handoverId       String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  taskId           String?               @db.Uuid
  claimId          String?
  leaveId          String?               @db.Uuid
  pipId            String?               @db.Uuid
  rPipId           String?               @db.Uuid
  hrDeptApprovalId String?               @db.Uuid
  claim            Claim?                @relation(fields: [claimId], references: [id])
  hrDeptApproval   HrDepartmentApproval? @relation(fields: [hrDeptApprovalId], references: [id])
  invite           Invite?               @relation(fields: [inviteId], references: [id])
  leave            LeaveRequest?         @relation(fields: [leaveId], references: [id])
  offboarding      Offboarding?          @relation(fields: [offboardingId], references: [id])
  payment          Payment?              @relation(fields: [paymentId], references: [id])
  pip              Pip?                  @relation(fields: [pipId], references: [id])
  rPip             RecommendedPip?       @relation(fields: [rPipId], references: [id])
  task             Task?                 @relation(fields: [taskId], references: [id])
  user             User?                 @relation(fields: [userId], references: [id])
  uploads          Upload[]
}

/// ///////////////////////////// ASSETS ///////////////////////
model Asset {
  id           String         @id @default(uuid()) @db.Uuid
  assetId      String         @unique
  name         String
  serialNo     String?        @unique
  category     AssetCategory?
  purchaseDate DateTime?
  vendor       String?
  cost         Float?
  description  String?
  isReturned   Boolean?       @default(false)
  status       AssetStatus?   @default(AVAILABLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assignments  Assignment[]
  faults       Fault[]
  assetImages  Upload[]       @relation("AssetImages")
}

model Assignment {
  id            String            @id @default(uuid())
  assetId       String            @db.Uuid
  userId        String            @db.Uuid
  assignedAt    DateTime
  retrievedAt   DateTime?
  notes         String?
  condition     String?
  status        AssignmentStatus?
  isVerified    Boolean           @default(false)
  isPaid        Boolean           @default(false)
  verifiedAt    DateTime?
  returnedAt    DateTime?
  offboardingId String?           @db.Uuid
  asset         Asset             @relation(fields: [assetId], references: [id])
  offboarding   Offboarding?      @relation(fields: [offboardingId], references: [id])
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fault {
  id           String      @id @default(uuid()) @db.Uuid
  assetId      String      @db.Uuid
  reportedById String?     @db.Uuid
  resolvedById String?     @db.Uuid
  images       String[]
  reason       String?
  notes        String?
  status       FaultStatus @default(PENDING)
  resolvedAt   DateTime?   @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  asset        Asset       @relation(fields: [assetId], references: [id])
  reportedBy   User?       @relation("reportedBy", fields: [reportedById], references: [id])
  resolvedBy   User?       @relation("resolvedBy", fields: [resolvedById], references: [id])

  @@index([reportedById])
  @@index([resolvedById])
  @@index([assetId])
  @@index([status])
}

model Offboarding {
  id              String       @id @default(uuid()) @db.Uuid
  type            ExitType
  reason          String
  noticePeriod    Boolean?     @default(false)
  status          Status       @default(PENDING)
  userId          String       @unique @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  relievingDate   DateTime?
  resignationDate DateTime?
  initiatedById   String       @db.Uuid
  assignments     Assignment[]
  clearance       Clearance[]
  comment         Comment[]
  initiatedBy     User         @relation("InitiatedBy", fields: [initiatedById], references: [id])
  user            User         @relation("InitiatedFor", fields: [userId], references: [id])
  payments        Payment[]
  uploads         Upload[]
}

model Clearance {
  id                  String               @id @default(uuid()) @db.Uuid
  type                ClearanceType
  status              ClearanceStatus      @default(PENDING)
  approvedBy          String?
  approvedAt          DateTime?
  offboardingId       String               @db.Uuid
  offboarding         Offboarding          @relation(fields: [offboardingId], references: [id])
  departmentClearance DepartmentClearance?
}

model TaskHandover {
  id          String               @id @default(uuid()) @db.Uuid
  taskId      String               @db.Uuid
  fromUserId  String               @db.Uuid
  toUserId    String               @db.Uuid
  clearanceId String?              @db.Uuid
  note        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  clearance   DepartmentClearance? @relation(fields: [clearanceId], references: [id])
  fromUser    User                 @relation("TransferredFrom", fields: [fromUserId], references: [id])
  task        Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toUser      User                 @relation("TransferredTo", fields: [toUserId], references: [id])
  upload      Upload[]
}

model DepartmentClearance {
  id                 String                   @id @default(uuid()) @db.Uuid
  clearedAt          DateTime?
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  clearanceId        String?                  @unique @db.Uuid
  tasksHandedOver    Boolean                  @default(false)
  employeeSignature  ClearanceDeptSignatures? @relation("EmployeeSignature")
  handoverESignature ClearanceDeptSignatures? @relation("HandoverEmployeeSignature")
  managerSignature   ClearanceDeptSignatures? @relation("ManagerSignature")
  clearance          Clearance?               @relation(fields: [clearanceId], references: [id])
  handover           TaskHandover[]
}

model Payment {
  id            String       @id @default(uuid()) @db.Uuid
  offboardingId String?      @db.Uuid
  approved      Boolean      @default(false)
  approvedBy    String?      @db.Uuid
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  comment       Comment[]
  offboarding   Offboarding? @relation(fields: [offboardingId], references: [id])
  uploads       Upload[]
}

model ClearanceDeptSignatures {
  id                   String               @id @default(uuid()) @db.Uuid
  signatureId          String?              @unique @db.Uuid
  signedAt             DateTime?
  employeeSignatureId  String?              @unique @db.Uuid
  managerSignatureId   String?              @unique @db.Uuid
  handoverESignatureId String?              @unique @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  employeeSignature    DepartmentClearance? @relation("EmployeeSignature", fields: [employeeSignatureId], references: [id])
  handoverESignature   DepartmentClearance? @relation("HandoverEmployeeSignature", fields: [handoverESignatureId], references: [id])
  managerSignature     DepartmentClearance? @relation("ManagerSignature", fields: [managerSignatureId], references: [id])
  signature            Upload?              @relation(fields: [signatureId], references: [id])
}

model Entitlement {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @unique
  unit        EntitlementUnit
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  type        EntitlementType?
  scope       EntitlementScope?
  claims      Claim[]
  departments DepartmentEntitlement[]
  request     LeaveRequest[]
  levels      LevelEntitlement[]
}

model LevelEntitlement {
  id            String      @id @default(uuid()) @db.Uuid
  levelId       String      @db.Uuid
  entitlementId String      @db.Uuid
  value         Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id])
  level         Level       @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([levelId, entitlementId])
}

model DepartmentEntitlement {
  id            String      @id @default(uuid()) @db.Uuid
  departmentId  String      @db.Uuid
  entitlementId String      @db.Uuid
  value         Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@unique([departmentId, entitlementId])
}

model LeaveRequest {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  doaId             String         @db.Uuid
  startDate         DateTime
  endDate           DateTime
  duration          Int
  currentApprovalId String?        @db.Uuid
  reason            String
  status            LeaveStatus    @default(PENDING)
  typeId            String         @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  approvals         Approval[]
  cancelRequest     CancelRequest?
  comments          Comment[]
  doa               User           @relation("deedOfAssignement", fields: [doaId], references: [id], onDelete: Cascade)
  type              Entitlement    @relation(fields: [typeId], references: [id])
  user              User           @relation("user", fields: [userId], references: [id])
  response          Response[]
  uploads           Upload[]
}

model CancelRequest {
  id        String       @id @default(uuid()) @db.Uuid
  requestId String       @unique @db.Uuid
  reason    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  request   LeaveRequest @relation(fields: [requestId], references: [id])
}

model Approver {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  departmentId String?     @db.Uuid
  role         Role
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  teamId       String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  team         Team?       @relation(fields: [teamId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Approval {
  id             String         @id @default(uuid()) @db.Uuid
  leaveRequestId String         @db.Uuid
  phase          Int
  approverId     String?        @db.Uuid
  status         ApprovalStatus @default(PENDING)
  note           String?
  actionDate     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  approver       User?          @relation(fields: [approverId], references: [id])
  leaveRequest   LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, phase])
}

model Response {
  id        String        @id @default(uuid()) @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  type      ResponseType
  userId    String        @db.Uuid
  requestId String?       @db.Uuid
  note      String
  request   LeaveRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payroll {
  id            String             @id @default(uuid()) @db.Uuid
  salary        Float
  gross         Float
  net           Float
  deductions    Float
  tax           Float?
  cra           Float?
  taxableIncome Float?
  pension       Float?
  nhf           Float?
  laa           Float?
  taxStatus     TaxStatus          @default(PENDING)
  userId        String             @unique @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  component     PayrollComponent[]
  payslip       Payslip[]
}

model PayrollComponent {
  id            String                 @id @default(uuid()) @db.Uuid
  amount        Float
  type          SalaryType
  title         String
  calculations  SalaryCalculationType
  category      ComponentCategory
  monthlyAmount Float
  annualAmount  Float
  duration      Int?
  startDate     DateTime?
  isActive      Boolean                @default(true)
  payrollId     String                 @db.Uuid
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  userId        String?                @db.Uuid
  status        PayrollComponentStatus @default(ACTIVE)
  payroll       Payroll                @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  user          User?                  @relation(fields: [userId], references: [id])
}

model Payslip {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  userId     String             @db.Uuid
  createdAt  DateTime           @default(now())
  month      String
  payrollId  String             @db.Uuid
  year       Int
  amount     Float
  updatedAt  DateTime?          @updatedAt
  deductions Float?
  earnings   Float?
  gross      Float?
  net        Float?
  payroll    Payroll            @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  components PayslipComponent[]

  @@unique([payrollId, month, year])
  @@index([userId])
}

model PayslipComponent {
  id            String                @id @default(uuid()) @db.Uuid
  amount        Float
  type          SalaryType
  title         String
  calculations  SalaryCalculationType
  category      ComponentCategory
  monthlyAmount Float
  annualAmount  Float
  duration      Int?
  startDate     DateTime?
  isActive      Boolean               @default(true)
  payslipId     String                @db.Uuid
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  userId        String?               @db.Uuid
  payslip       Payslip               @relation(fields: [payslipId], references: [id], onDelete: Cascade)
}

model Deductions {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  month     String
  pension   Decimal  @db.Decimal(15, 2)
  tax       Decimal  @db.Decimal(15, 2)

  @@index([month])
}

/// //////////////////////////////////////// CLAIMS ///////////////////////////////////////////
model Claim {
  id            String       @id @default(uuid())
  title         String
  amount        Float
  dateOfExpense DateTime
  description   String?
  notes         String?
  status        ClaimStatus  @default(PENDING)
  createdAt     DateTime?    @default(now())
  updatedAt     DateTime?    @updatedAt
  userId        String       @db.Uuid
  claimId       String       @unique
  entitlementId String?      @db.Uuid
  pipId         String?      @unique @db.Uuid
  type          ClaimType?
  entitlement   Entitlement? @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  pip           Pip?         @relation(fields: [pipId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  comments      Comment[]
  proofUrls     Upload[]

  @@index([id])
}

model TaskIssues {
  id         String   @id @default(uuid()) @db.Uuid
  issue      String
  taskId     String?  @db.Uuid
  userId     String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reportedBy User?    @relation(fields: [userId], references: [id])
}

model ExtensionRequests {
  id          String       @id @default(uuid()) @db.Uuid
  taskId      String?      @db.Uuid
  requesterId String?      @db.Uuid
  dueDate     DateTime
  note        String?
  status      ClaimStatus? @default(PENDING)
  isVisible   Boolean?     @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  requester   User?        @relation(fields: [requesterId], references: [id])
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Task {
  title               String
  description         String?
  startDate           DateTime?
  dueDate             DateTime?
  status              TaskStatus          @default(PENDING_APPROVAL)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdById         String              @db.Uuid
  approvalRequestedAt DateTime?
  approvalStatus      ApprovalStatus      @default(PENDING)
  approvedAt          DateTime?
  approvedById        String?             @db.Uuid
  rejectionReason     String?
  id                  String              @id @default(uuid()) @db.Uuid
  priority            String?
  taskId              String?             @unique
  hasIssues           Boolean?            @default(false)
  isReported          Boolean             @default(false)
  departmentId        String?             @db.Uuid
  hasTransfer         Boolean?            @default(false)
  teamId              String?             @db.Uuid
  hasDeadline         Boolean?
  links               String[]
  comments            Comment[]
  extensionRequests   ExtensionRequests[]
  logs                Logs[]
  reportItems         ReportItem[]
  approvedBy          User?               @relation("ApprovedTasks", fields: [approvedById], references: [id], onDelete: Cascade)
  createdBy           User                @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  team                Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  handOver            TaskHandover[]
  taskIssues          TaskIssues[]
  taskTransfers       TaskTransfer[]
  uploads             Upload[]
  assignees           UserTask[]
  taskDueDates        taskDueDate[]
  category            Category[]          @relation("CategoryToTask")
  projectLabels       ProjectLabels[]     @relation("ProjectLabelsToTask")
  reports             Report[]            @relation("ReportToTask")
}

model taskDueDate {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String?   @db.Uuid
  dueDate   DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskTransfer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  taskId    String?  @db.Uuid
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id        String   @id @default(uuid()) @db.Uuid
  week      Int
  title     String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]   @relation("ReportToTask")
}

model DepartmentWeeklyReport {
  id           String        @id @default(uuid())
  reportId     String        @unique
  departmentId String        @db.Uuid
  title        String
  week         Int
  status       ReportStatus?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  department   Department    @relation(fields: [departmentId], references: [id])
  reports      ReportItem[]

  @@unique([departmentId, week])
}

model ReportItem {
  id             String                 @id @default(uuid())
  title          String
  description    String?
  taskId         String?                @db.Uuid
  weeklyReportId String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  projectId      String?                @db.Uuid
  project        ProjectLabels?         @relation(fields: [projectId], references: [id])
  task           Task?                  @relation(fields: [taskId], references: [id])
  weeklyReport   DepartmentWeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  attachments    Upload[]
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String?       @unique
  title       String        @unique
  description String?
  color       String?
  type        CategoryType?
  userId      String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments Department[]  @relation("CategoryToDepartment")
  tasks       Task[]        @relation("CategoryToTask")
}

model ProjectLabels {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String?       @unique
  title       String        @unique
  description String?
  color       String?
  type        CategoryType?
  userId      String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportItems ReportItem[]
  departments Department[]  @relation("DepartmentToProjectLabels")
  tasks       Task[]        @relation("ProjectLabelsToTask")
}

model UserTask {
  id         String   @id @default(uuid()) @db.Uuid
  assignedAt DateTime @default(now())
  userId     String   @db.Uuid
  taskId     String   @db.Uuid
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model Logs {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  actionAt    DateTime @default(now())
  actionById  String?  @db.Uuid
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  actionToId  String?  @db.Uuid
  taskId      String?  @db.Uuid
  actionBy    User?    @relation("LogActor", fields: [actionById], references: [id])
  actionTo    User?    @relation("LogTo", fields: [actionToId], references: [id])
  task        Task?    @relation(fields: [taskId], references: [id])
  attachments Upload[]
}

model Appraisal {
  id                   String                        @id @default(uuid()) @db.Uuid
  quarter              String
  year                 Int
  managerComment       String?
  period               String
  submittedAt          DateTime?
  appraisedAt          DateTime?
  hrReviewedAt         DateTime?
  averageRating        Float?
  templateId           String?
  createdBy            String?
  autoGenerated        Boolean                       @default(true)
  isTemplate           Boolean                       @default(false)
  status               AppraisalStatus               @default(PENDING)
  departmentId         String                        @db.Uuid
  appraiserId          String?                       @db.Uuid
  appraisedId          String?                       @db.Uuid
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  employeeComment      String?
  achievements         Achievement[]
  appraised            User?                         @relation("Appraised", fields: [appraisedId], references: [id])
  appraiser            User?                         @relation("Appraiser", fields: [appraiserId], references: [id])
  department           Department                    @relation(fields: [departmentId], references: [id])
  kpi                  AppraisalKpi[]
  leadershipAssessment AppraisalLeadershipSnapshot[]
  employeeSignature    AppraisalSignatures?          @relation("employeeSignature")
  managerSignature     AppraisalSignatures?          @relation("managerSignature")
  competencyAssessment CompetencyCategorySnapshot[]
  developmentNeeds     DevelopmentNeed[]
  goals                Goals[]
  summary              RatingSummary?

  @@unique([quarter, year, appraisedId])
}

model AppraisalKpi {
  id           String     @id @default(uuid()) @db.Uuid
  objective    String
  actualResult String
  rating       Float
  appraisalId  String?    @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  comment      String?
  appraisal    Appraisal? @relation(fields: [appraisalId], references: [id])
}

model AppraisalSignatures {
  id                  String     @id @default(uuid()) @db.Uuid
  signatureId         String?    @unique @db.Uuid
  date                DateTime?
  managerSignatureId  String?    @unique @db.Uuid
  employeeSignatureId String?    @unique @db.Uuid
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  employeeSignature   Appraisal? @relation("employeeSignature", fields: [employeeSignatureId], references: [id], onDelete: Cascade)
  managerSignature    Appraisal? @relation("managerSignature", fields: [managerSignatureId], references: [id], onDelete: Cascade)
  signature           Upload?    @relation(fields: [signatureId], references: [id])
}

model AppraisalLeadership {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rating    Float?
  comment   String?
}

model CompetencyCategory {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  objectives      Objective[]
  ratingSummaries RatingSummary[]
}

model Objective {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  rating       Float?
  comment      String?
  categoryId   String?             @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  actualResult String?
  category     CompetencyCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model CompetencyObjectiveSnapshot {
  id           String                      @id @default(uuid()) @db.Uuid
  name         String
  rating       Float?
  actualResult String?
  comment      String?
  categoryId   String?                     @db.Uuid
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  category     CompetencyCategorySnapshot? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model RatingSummarySnapshot {
  id                           String                      @id @default(uuid()) @db.Uuid
  averageRating                Float
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  competencyCategorySnapshotId String?                     @db.Uuid
  competencyCategorySnapshot   CompetencyCategorySnapshot? @relation(fields: [competencyCategorySnapshotId], references: [id])
}

model CompetencyCategorySnapshot {
  id          String                        @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  appraisalId String?                       @db.Uuid
  appraisal   Appraisal?                    @relation(fields: [appraisalId], references: [id])
  objectives  CompetencyObjectiveSnapshot[]
  summary     RatingSummarySnapshot[]
}

model AppraisalLeadershipSnapshot {
  id          String    @id @default(uuid()) @db.Uuid
  appraisalId String    @db.Uuid
  title       String
  rating      Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comment     String?
  appraisal   Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@index([appraisalId])
}

model Achievement {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  appraisalId String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  appraisal   Appraisal? @relation(fields: [appraisalId], references: [id])
}

model DevelopmentNeed {
  id              String     @id @default(uuid()) @db.Uuid
  title           String
  supportRequired String
  timeline        Int
