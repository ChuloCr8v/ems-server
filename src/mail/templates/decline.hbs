<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Offer Declined</title>

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;800&display=swap'
      rel='stylesheet'
    />

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        font-family: 'Raleway', Arial, sans-serif;
      }

      table {
        border-collapse: collapse;
      }

      img {
        border: 0;
        display: block;
      }

      a {
        color: #0066cc;
        text-decoration: none;
      }

      .btn {
        display: inline-block;
        padding: 12px 24px;
        background-color: #d32f2f;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 600;
        margin-top: 20px;
      }

      .focus {
        font-weight: 600;
        color: #0f172a;
      }
    </style>
  </head>

  <body>
    <!-- Outer wrapper -->
    <table width='100%' bgcolor='#ffffff' cellpadding='0' cellspacing='0'>
      <tr>
        <td align='center'>
          <!-- Main container -->
          <table width='800' cellpadding='0' cellspacing='0' bgcolor='#f8fafc'>
            <!-- Header -->
            <tr>
              <td style='padding: 42px 48px'>
                <table width='100%'>
                  <tr>
                    <td align='left'>
                      <img
                        src='https://ems.miro.zoracom.com/logo.png'
                        alt='Zoracom Limited'
                        width='120'
                      />
                    </td>
                    <td align='right'>
                      <table cellpadding='0' cellspacing='0'>
                        <tr>
                          <td style='padding-left: 20px'>
                            <a href='https://x.com/Zoracom_'>
                              <img
                                src='https://img.icons8.com/?size=50&id=phOKFKYpe00C&format=png'
                                width='32'
                                alt='Twitter'
                              />
                            </a>
                          </td>
                          <td style='padding-left: 20px'>
                            <a href='https://www.facebook.com/zoracom'>
                              <img
                                src='https://img.icons8.com/?size=48&id=uLWV5A9vXIPu&format=png'
                                width='32'
                                alt='Facebook'
                              />
                            </a>
                          </td>
                          <td style='padding-left: 20px'>
                            <a
                              href='https://www.linkedin.com/company/zoracom-limited/'
                            >
                              <img
                                src='https://img.icons8.com/?size=48&id=114445&format=png'
                                width='32'
                                alt='LinkedIn'
                              />
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Content Card -->
            <tr>
              <td align='center'>
                <table
                  width='705'
                  cellpadding='0'
                  cellspacing='0'
                  bgcolor='#ffffff'
                  style='
                    border-radius: 12px 12px 0 0;
                    box-shadow: 3px 2px 18px rgb(0, 0, 0, 0.1);
                  '
                >
                  <tr>
                    <td style='padding: 40px 48px'>
                      <h1
                        style='
                          font-size: 24px;
                          font-weight: 800;
                          margin: 0 0 24px;
                          color: #000000;
                        '
                      >
                        {{name}}
                        Declined Their Offer
                      </h1>

                      <p
                        style='
                          font-size: 16px;
                          color: #384860;
                          margin: 0 0 16px;
                        '
                      >
                        Hello
                        <strong>Admin</strong>,
                      </p>

                      <p
                        style='
                          font-size: 16px;
                          color: #5e5e5e;
                          line-height: 1.5;
                          margin: 0 0 32px;
                        '
                      >
                        <strong>{{name}}</strong>
                        has declined the offer to join Zoracom. You may archive
                        their record or reach out for clarification.
                      </p>

                      <p
                        style='
                          margin-top: 40px;
                          font-size: 14px;
                          color: #5e5e5e;
                        '
                      >
                        Best Regards,<br />
                        <strong>Talent X</strong>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td bgcolor='#ecf8ee' style='padding: 40px 48px'>
                <p style='font-size: 14px; margin: 0 0 16px'>
                  Have questions?
                  <br />
                  Contact us at
                  <a href='mailto:hr@zoracom.com'>hr@zoracom.com</a>.
                  <br />
                  Don’t want any more emails from Zoracom?
                  <a href='#'>Unsubscribe</a>.
                </p>

                <p style='font-size: 14px; margin: 0 0 8px'>
                  NSOC Building: 25 Bafaj Crescent, Ogunfayo Lekki-Epe
                  Expressway, Lagos, Nigeria
                </p>

                <p style='font-size: 14px; margin: 0'>
                  Copyright
                  {{date}}
                  © Zora Communications Limited. All Rights Reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>