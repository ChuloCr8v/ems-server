<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your Payslip Is Ready</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap'
      rel='stylesheet'
    />

    <style
    >
      body {
        margin: 0;
        padding: 0;
        font-family: 'Raleway', sans-serif;
        background-color: #ffffff;
        {{! min-height: 100vh; }}
        display: flex;
        flex-direction: column,
        justify-content: center;
        align-items: center;
      }

      .wrapper {
        width: 800px;
        background-color: #f8fafc;
        margin: 20px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
      }

      .header {
        width: 100%;
        height: 104px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 42px 48px;
      }

      .zoracom-logo {
        width: 161px;
        height: 30px;
      }

      .social-icons {
        display: flex;
        gap: 24px;
      }

      .social-icon {
        width: 24px;
        height: 24px;
      }

      .content-wrapper {
        width: 705px;
        margin: 0 auto;
        background-color: #ffffff;
        padding: 0 48px;
        border-radius: 4px;
        margin-bottom: 20px;
      }

      .content {
        color: #333333;
        font-size: 16px;
        line-height: 1.5;
        padding: 24px 0 40px;
      }

      h1 {
        font-size: 24px;
        font-weight: 600;
        margin: 0 0 24px 0;
      }

      .greeting {
        font-size: 16px;
        margin-top: -20px;
        color: #384860;
      }

      .message {
        font-size: 16px;
        margin-top: -40px;
        color: #5e5e5e;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: #0a96cc;
        color: #fff;
        text-decoration: none;
        padding: 10px 32px;
        border-radius: 4px;
        margin-top: 10px;
      }

      .button:hover {
        background-color: #007bb8;
      }

      .signature {
        margin-top: 40px;
        line-height: 1.3;
      }

      .footer {
        font-size: 12px;
        color: #666666;
        padding: 40px 48px 24px;
        border-top: 1px solid #eeeeee;
        line-height: 1.5;
        background-color: #ecf8ee;
        margin-top: 20px;
      }

      .footer-content {
        max-width: 100%;
        margin: 0 auto;
      }

      .fcontent1,
      .fcontent2,
      .fcontent3 {
        font-size: 14px;
        margin: 6px 0;
      }

      a {
        color: #0a96cc;
      }
    </style>
  </head>

  <body>
    <div class='wrapper'>
      <div class='header'>
        <img
          src='../assets/Zoracom.png'
          alt='Zoracom Logo'
          class='zoracom-logo'
        />

        <div class='social-icons'>
          <a href='#'><img
              src='../assets/Social icon - Twitter.svg'
              class='social-icon'
            /></a>
          <a href='#'><img src='../assets/Vector.svg' class='social-icon' /></a>
          <a href='#'><img
              src='../assets/Group (2).svg'
              class='social-icon'
            /></a>
        </div>
      </div>

      <div class='content-wrapper'>
        <div class='content'>
          <h1>Your Payslip Is Ready</h1>

          <p class='greeting'>Hello <span class='Name'>{{name}}</span>,</p>

          <p class='message'>
            Your payslip for
            <strong>{{month}}</strong>
            has been successfully generated.
            <br /><br />
            You can now Log in to your
            <strong>Zoracom EMS Dashboard</strong>
            to view your payslip anytime.
            <br /><br />
            If you have any questions or notice any discrepancies, please
            contact the HR team.
          </p>

          <a href='{{dashboardUrl}}' class='button'>Go to Dashboard</a>

          <div class='signature'>
            <span class='cheeers'>Regards,</span><br />
            <span class='ID'>Zoracom EMS</span>
          </div>
        </div>
      </div>

      <div class='footer'>
        <div class='footer-content'>
          <p class='fcontent1'>
            Questions or concerns? Contact us at
            <a href='mailto:hrteam@zoracom.com'>hrteam@zoracom.com</a>.
          </p>

          <p class='fcontent2'>
            NSOC Building: 25 Bafaj Crescent, Ogunfayo Lekki-Epe Expressway,
            Lagos, Nigeria
          </p>

          <p class='fcontent3'>
            ©
            {{date}}
            Zora Communications Limited. All Rights Reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>