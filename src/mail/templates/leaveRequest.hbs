<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Leave Request Notification</title>

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;800&display=swap'
      rel='stylesheet'
    />

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        font-family: 'Raleway', Arial, sans-serif;
      }
      table {
        border-collapse: collapse;
      }
      img {
        border: 0;
        display: block;
      }
      a {
        color: #0066cc;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <!-- Outer wrapper -->
    <table width='100%' bgcolor='#ffffff' cellpadding='0' cellspacing='0'>
      <tr>
        <td align='center'>

          <!-- Main container -->
          <table width='640' cellpadding='0' cellspacing='0' bgcolor='#f8fafc'>

            <!-- Header -->
            <tr>
              <td style='padding: 32px;'>
                <table width='100%'>
                  <tr>
                    <td align='left'>
                      <img
                        src='https://ems.miro.zoracom.com/logo.png'
                        alt='Zoracom Limited'
                        width='150'
                      />
                    </td>
                    <td align='right'>
                      <table cellpadding='0' cellspacing='0'>
                        <tr>
                          <td style='padding-left: 16px;'>
                            <a href='https://x.com/Zoracom_'>
                              <img
                                src='https://img.icons8.com/?size=50&id=phOKFKYpe00C&format=png'
                                width='28'
                                alt='Twitter'
                              />
                            </a>
                          </td>
                          <td style='padding-left: 16px;'>
                            <a href='https://www.facebook.com/zoracom'>
                              <img
                                src='https://img.icons8.com/?size=48&id=uLWV5A9vXIPu&format=png'
                                width='28'
                                alt='Facebook'
                              />
                            </a>
                          </td>
                          <td style='padding-left: 16px;'>
                            <a
                              href='https://www.linkedin.com/company/zoracom-limited/'
                            >
                              <img
                                src='https://img.icons8.com/?size=48&id=114445&format=png'
                                width='28'
                                alt='LinkedIn'
                              />
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Content Card -->
            <tr>
              <td align='center'>
                <table
                  width='560'
                  cellpadding='0'
                  cellspacing='0'
                  bgcolor='#ffffff'
                  style='border-radius: 12px;'
                >
                  <tr>
                    <td style='padding: 32px;'>

                      <h1
                        style='
                          text-align: center;
                          font-size: 22px;
                          font-weight: 800;
                          margin: 0 0 20px;
                          color: #000000;
                        '
                      >
                        Leave Request Notification
                      </h1>

                      <p
                        style='font-size: 15px; color: #384860; margin: 0 0 14px;'
                      >
                        Hello,
                      </p>

                      <p
                        style='
                          font-size: 15px;
                          color: #5e5e5e;
                          line-height: 1.5;
                          margin: 0 0 24px;
                        '
                      >
                        <strong>{{name}}</strong>
                        has submitted a leave request that requires your review
                        and approval.
                      </p>

                      <!-- Leave details -->
                      <table
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        style='background-color: #f8fafc; margin-bottom: 24px;'
                      >
                        <tr>
                          <td
                            style='padding: 8px 14px; font-weight: 600; color: #384860;'
                          >
                            Employee
                          </td>
                          <td style='padding: 8px 14px; color: #5e5e5e;'>
                            {{name}}
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='padding: 8px 14px; font-weight: 600; color: #384860;'
                          >
                            Leave Type
                          </td>
                          <td style='padding: 8px 14px; color: #5e5e5e;'>
                            {{leaveType}}
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='padding: 8px 14px; font-weight: 600; color: #384860;'
                          >
                            Duration
                          </td>
                          <td style='padding: 8px 14px; color: #5e5e5e;'>
                            {{formatDate startDate 'MMMM DD, YYYY'}}
                            –
                            {{formatDate endDate 'MMMM DD, YYYY'}}
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='padding: 8px 14px; font-weight: 600; color: #384860;'
                          >
                            Reason
                          </td>
                          <td style='padding: 8px 14px; color: #5e5e5e;'>
                            {{reason}}
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='padding: 8px 14px; font-weight: 600; color: #384860;'
                          >
                            Status
                          </td>
                          <td
                            style='padding: 8px 14px; color: #ed6c02; font-weight: 600;'
                          >
                            Pending Approval
                          </td>
                        </tr>
                      </table>

                      <!-- Button -->
                      <table align='center' cellpadding='0' cellspacing='0'>
                        <tr>
                          <td
                            bgcolor='#0a96cc'
                            style='border-radius: 200px; text-align: center;'
                          >
                            <a
                              href='{{reviewLink}}'
                              style='
                                display: inline-block;
                                padding: 10px 36px;
                                font-size: 13px;
                                color: #ffffff;
                                font-weight: 600;
                              '
                            >
                              Review Leave Request
                            </a>
                          </td>
                        </tr>
                      </table>

                      <p style='margin-top: 32px; font-size: 13px;'>
                        Cheers,<br />
                        <strong>The HR Team</strong>
                      </p>

                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td bgcolor='#ecf8ee' style='padding: 32px;'>
                <p style='font-size: 13px; margin: 0 0 12px;'>
                  Questions or FAQ? Contact us at
                  <a href='mailto:hrteam@zoracom.com'>hrteam@zoracom.com</a>.
                </p>

                <p style='font-size: 13px; margin: 0 0 8px;'>
                  NSOC Building: 25 Bafaj Crescent, Ogunfayo Lekki-Epe
                  Expressway, Lagos, Nigeria
                </p>

                <p style='font-size: 13px; margin: 0;'>
                  © 2025 Zora Communications Limited. All Rights Reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>