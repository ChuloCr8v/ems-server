<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{subject}}</title>

    ```
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    ```
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background: #f4f6f8;
      font-family: &quot;Raleway&quot;, Arial, sans-serif;
    "
  >
    ```
    <!-- Preheader -->
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0">
      {{subject}}
    </div>

    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 20px 0">
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="background: #ffffff; border-radius: 8px; overflow: hidden"
          >
            <!-- Header -->
            <tr>
              <td style="padding: 20px 24px">
                <table width="100%">
                  <tr>
                    <!-- Logo -->
                    <td align="left">
                      <img
                        src="https://zoracom.com/assets/logo-DyYoQ1Iz.png"
                        width="140"
                        alt="Zoracom"
                      />
                    </td>

                    <!-- Social Icons -->
                    <td align="right">
                      <table cellpadding="0" cellspacing="0" align="right">
                        <tr>
                          <!-- X -->
                          <td style="padding-left: 10px">
                            <a href="https://x.com/Zoracom_">
                              <span
                                style="
                                  display: inline-block;
                                  width: 32px;
                                  height: 32px;
                                  background: #e6f7fd;
                                  border-radius: 50%;
                                  text-align: center;
                                  line-height: 30px;
                                "
                              >
                                <img
                                  src="https://img.icons8.com/ios-filled/50/00afef/twitterx.png"
                                  width="16"
                                  style="vertical-align: middle"
                                />
                              </span>
                            </a>
                          </td>

                          <!-- Facebook -->
                          <td style="padding-left: 10px">
                            <a href="https://www.facebook.com/zoracom">
                              <span
                                style="
                                  display: inline-block;
                                  width: 32px;
                                  height: 32px;
                                  background: #e6f7fd;
                                  border-radius: 50%;
                                  text-align: center;
                                  line-height: 30px;
                                "
                              >
                                <img
                                  src="https://img.icons8.com/ios-filled/50/00afef/facebook.png"
                                  width="16"
                                  style="vertical-align: middle"
                                />
                              </span>
                            </a>
                          </td>

                          <!-- LinkedIn -->
                          <td style="padding-left: 10px">
                            <a
                              href="https://www.linkedin.com/company/zoracom-limited/"
                            >
                              <span
                                style="
                                  display: inline-block;
                                  width: 32px;
                                  height: 32px;
                                  background: #e6f7fd;
                                  border-radius: 50%;
                                  text-align: center;
                                  line-height: 30px;
                                "
                              >
                                <img
                                  src="https://img.icons8.com/ios-filled/50/00afef/linkedin.png"
                                  width="16"
                                  style="vertical-align: middle"
                                />
                              </span>
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Banner -->
            <tr>
              <td
                style="
                  background: #014158;
                  color: #ffffff;
                  text-align: center;
                  padding: 26px 20px;
                "
              >
                <h2 style="margin: 0; font-weight: 600; font-size: 18px">
                  {{subject}}
                </h2>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td
                style="
                  padding: 30px;
                  padding-bottom: 0;
                  color: #333;
                  line-height: 1.6;
                  font-size: 14px;
                "
              >
                {{{message}}}
              </td>
            </tr>

            <tr>
              <td>
                <!-- Styled Quote -->
                <p
                  style="
                    font-style: italic;
                    color: #007bbf;
                    padding: 12px;
                    font-weight: 600;
                    font-size: 14px;
                    background: #e6f7fd;
                    text-align: center;
                  "
                >
                  Execute Once, Operate Flawlessly, and Scale Everywhere
                </p>
              </td>
            </tr>

            <!-- Contact Section -->
            <tr>
              <td
                style="
                  background: #f9fafb;
                  border-top: 1px solid #e5e7eb;
                  padding: 20px 24px;
                "
                align="center"
              >
                <table cellpadding="0" cellspacing="0" align="center">
                  <tr>
                    <!-- Phone -->
                    <td
                      style="
                        font-size: 13px;
                        padding-right: 18px;
                        white-space: nowrap;
                        text-align: center;
                      "
                    >
                      <span
                        style="
                          display: inline-block;
                          width: 26px;
                          height: 26px;
                          background: #e6f7fd;
                          border-radius: 50%;
                          text-align: center;
                          line-height: 26px;
                          margin-right: 6px;
                        "
                      >
                        <img
                          src="https://img.icons8.com/ios-filled/50/00afef/phone.png"
                          width="16"
                          style="vertical-align: middle"
                        />
                      </span>
                      <a href="tel:+2348026615660" style="color: #0b3a75">
                        +234 802 661 5660
                      </a>
                    </td>

                    <!-- Email -->
                    <td
                      style="
                        font-size: 13px;
                        padding-right: 18px;
                        white-space: nowrap;
                        text-align: center;
                      "
                    >
                      <span
                        style="
                          display: inline-block;
                          width: 26px;
                          height: 26px;
                          background: #e6f7fd;
                          border-radius: 50%;
                          text-align: center;
                          line-height: 26px;
                          margin-right: 6px;
                        "
                      >
                        <img
                          src="https://img.icons8.com/ios-filled/50/00afef/new-post.png"
                          width="16"
                          style="vertical-align: middle"
                        />
                      </span>
                      <a href="mailto:info@zoracom.com" style="color: #0b3a75">
                        info@zoracom.com
                      </a>
                    </td>

                    <!-- Website -->
                    <td
                      style="
                        font-size: 13px;
                        white-space: nowrap;
                        text-align: center;
                      "
                    >
                      <span
                        style="
                          display: inline-block;
                          width: 26px;
                          height: 26px;
                          background: #e6f7fd;
                          border-radius: 50%;
                          text-align: center;
                          line-height: 26px;
                          margin-right: 6px;
                        "
                      >
                        <img
                          src="https://img.icons8.com/ios-filled/50/00afef/domain.png"
                          width="16"
                          style="vertical-align: middle"
                        />
                      </span>
                      <a href="https://zoracom.com" style="color: #0b3a75">
                        zoracom.com
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background: #014158;
                  color: #ffffff;
                  text-align: center;
                  padding: 15px;
                  font-size: 12px;
                "
              >
                © {{date}} Zoracom. All Rights Reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
    ```
  </body>
</html>
