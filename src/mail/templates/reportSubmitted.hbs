<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>New Report Submitted</title>

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;800&display=swap'
      rel='stylesheet'
    />

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        font-family: 'Raleway', Arial, sans-serif;
      }

      table {
        border-collapse: collapse;
      }

      img {
        border: 0;
        display: block;
      }

      a {
        color: #0066cc;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <!-- Outer wrapper -->
    <table width='100%' bgcolor='#ffffff' cellpadding='0' cellspacing='0'>
      <tr>
        <td align='center'>

          <!-- Main container -->
          <table width='800' cellpadding='0' cellspacing='0' bgcolor='#f8fafc'>

            <!-- Header -->
            <tr>
              <td style='padding: 42px 48px;'>
                <table width='100%'>
                  <tr>
                    <td align='left'>
                      <img
                        src='https://ems.miro.zoracom.com/logo.png'
                        alt='Zoracom Limited'
                        width='161'
                      />
                    </td>
                    <td align='right'>
                      <table cellpadding='0' cellspacing='0'>
                        <tr>
                          <td style='padding-left: 20px;'>
                            <a href='https://x.com/Zoracom_'>
                              <img
                                src='https://img.icons8.com/?size=50&id=phOKFKYpe00C&format=png'
                                width='32'
                                alt='Twitter'
                              />
                            </a>
                          </td>
                          <td style='padding-left: 20px;'>
                            <a href='https://www.facebook.com/zoracom'>
                              <img
                                src='https://img.icons8.com/?size=48&id=uLWV5A9vXIPu&format=png'
                                width='32'
                                alt='Facebook'
                              />
                            </a>
                          </td>
                          <td style='padding-left: 20px;'>
                            <a
                              href='https://www.linkedin.com/company/zoracom-limited/'
                            >
                              <img
                                src='https://img.icons8.com/?size=48&id=114445&format=png'
                                width='32'
                                alt='LinkedIn'
                              />
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Content Card -->
            <tr>
              <td align='center'>
                <table
                  width='705'
                  cellpadding='0'
                  cellspacing='0'
                  bgcolor='#ffffff'
                  style='border-radius: 12px;'
                >
                  <tr>
                    <td style='padding: 40px 48px;'>

                      <h1
                        style='
                          text-align: center;
                          font-size: 24px;
                          font-weight: 800;
                          margin: 0 0 24px;
                          color: #000000;
                        '
                      >
                        New Report Submitted
                      </h1>

                      <p
                        style='
                          font-size: 16px;
                          color: #384860;
                          margin: 0 0 16px;
                        '
                      >
                        Hello

                      </p>

                      <p
                        style='
                          font-size: 16px;
                          color: #5e5e5e;
                          line-height: 1.5;
                          margin: 0 0 32px;
                        '
                      >
                        A new weekly report has been submitted for review.
                      </p>

                      <table
                        width='100%'
                        style='margin: 0 0 32px; font-size: 16px; color: #5e5e5e; line-height: 1.5;'
                      >
                        {{!-- <tr>
                          <td width='150'><strong>Report Title:</strong></td>
                          <td>{{reportTitle}}</td>
                        </tr> --}}
                        <tr>
                          <td><strong>Week:</strong></td>
                          <td>Week {{week}}</td>
                        </tr>
                        <tr>
                          <td><strong>Department:</strong></td>
                          <td>{{departmentName}}</td>
                        </tr>
                      </table>

                      <!-- Button -->
                      <table align='center' cellpadding='0' cellspacing='0'>
                        <tr>
                          <td
                            bgcolor='#0a96cc'
                            style='
                              border-radius: 200px;
                              text-align: center;
                            '
                          >
                            <a
                              href='{{dashboardUrl}}'
                              style='
                                display: inline-block;
                                padding: 12px 45px;
                                font-size: 14px;
                                color: #ffffff;
                                font-weight: 600;
                              '
                            >
                              View Report
                            </a>
                          </td>
                        </tr>
                      </table>

                      <p style='margin-top: 40px; font-size: 14px;'>
                        Regards,<br />
                        <strong>TalentX</strong>
                      </p>

                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td bgcolor='#ecf8ee' style='padding: 40px 48px;'>
                <p style='font-size: 14px; margin: 0 0 16px;'>
                  NSOC Building: 25 Bafaj Crescent, Ogunfayo Lekki-Epe
                  Expressway, Lagos, Nigeria
                </p>

                <p style='font-size: 14px; margin: 0;'>
                  Copyright 2025 © Zora Communications Limited. All Rights
                  Reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>